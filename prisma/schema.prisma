model FinancialTransaction {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  accountId     String           @map("account_id") @db.Uuid
  type          String           @db.VarChar(20)
  amount        Decimal          @db.Decimal(12, 2)
  reference     String?
  referenceType String?          @map("reference_type") @db.VarChar(50)
  occurredAt    DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(6)
  account       FinancialAccount @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@map("financial_transactions")
}

model DailyCashClosing {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  accountId     String           @map("account_id") @db.Uuid
  date          DateTime         @db.Date
  openingAmount Decimal          @map("opening_amount") @db.Decimal(12, 2)
  closingAmount Decimal          @map("closing_amount") @db.Decimal(12, 2)
  countedAmount Decimal          @map("counted_amount") @db.Decimal(12, 2)
  discrepancy   Decimal          @default(0) @db.Decimal(12, 2)
  closedBy      String           @map("closed_by") @db.Uuid
  account       FinancialAccount @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, accountId, date])
  @@map("daily_cash_closings")
}

model BankReconciliation {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  accountId        String           @map("account_id") @db.Uuid
  statementDate    DateTime         @map("statement_date") @db.Date
  statementBalance Decimal          @map("statement_balance") @db.Decimal(12, 2)
  bookBalance      Decimal          @map("book_balance") @db.Decimal(12, 2)
  reconciledBy     String           @map("reconciled_by") @db.Uuid
  notes            String?
  account          FinancialAccount @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@map("bank_reconciliations")
}

model FinancialPeriod {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  name          String         @db.VarChar(100)
  startDate     DateTime       @map("start_date") @db.Date
  endDate       DateTime       @map("end_date") @db.Date
  isClosed      Boolean        @default(false) @map("is_closed")
