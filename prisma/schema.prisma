// ---------------------------------------------------------------------------
// TIMETABLE
// ---------------------------------------------------------------------------

model TimetableEntry {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  academicYearId String  @map("academic_year_id") @db.Uuid
  termId         String? @map("term_id") @db.Uuid

  // One stored week per timetable type; exam weeks are further keyed by exam name.
  timetableType String @default("REGULAR") @map("timetable_type") @db.VarChar(20)
  examName      String @default("") @map("exam_name") @db.VarChar(150)

  // Class-scoped so a class's grid can be read/written without any section.
  // Nullable subject/teacher because a Break row has neither.
  classId   String  @map("class_id") @db.Uuid
  isBreak   Boolean @default(false) @map("is_break")
  subjectId String? @map("subject_id") @db.Uuid
  teacherId String? @map("teacher_id") @db.Uuid

  dayOfWeek DayOfWeek @map("day_of_week")
  startTime String    @db.VarChar(5)
  endTime   String    @db.VarChar(5)
  periodNo  Int       @map("period_no")

  room String? @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId, tenantId], references: [id, tenantId], onDelete: Cascade)
  term         AcademicTerm? @relation(fields: [termId, tenantId], references: [id, tenantId], onDelete: Cascade)
  schoolClass  SchoolClass   @relation(fields: [classId, tenantId], references: [id, tenantId], onDelete: Cascade)
  subject      Subject?      @relation(fields: [subjectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  teacher      Teacher?      @relation(fields: [teacherId, tenantId], references: [id, tenantId], onDelete: Cascade)

  // One row per class/day/period within a timetable type (and exam name) Ã¢â‚¬â€ the batch upsert keys on exactly this.
  @@unique([tenantId, classId, timetableType, examName, dayOfWeek, periodNo])
  @@unique([id, tenantId])
  @@index([tenantId, academicYearId, termId, dayOfWeek, periodNo])
  @@index([tenantId, dayOfWeek])
  @@index([tenantId, academicYearId])
  @@index([tenantId, termId])
  @@index([tenantId, classId])
  @@index([tenantId, subjectId])
  @@index([tenantId, teacherId])
  @@map("timetable_entries")
}

model SportTimetableEntry {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  classId   String    @map("class_id") @db.Uuid
  sport     String    @db.VarChar(150)
  day       DayOfWeek
  slotNo    Int       @map("slot_no")
  startTime String    @db.VarChar(5)
  endTime   String    @db.VarChar(5)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass @relation(fields: [classId, tenantId], references: [id, tenantId], onDelete: Cascade)

  // Enforces "at most 2 slots per class per day" at the database level.
  @@unique([tenantId, classId, day, slotNo])
  @@unique([id, tenantId])
  @@index([tenantId, classId])
  @@map("sport_timetable_entries")
}

// ---------------------------------------------------------------------------
// GRADING
// ---------------------------------------------------------------------------

model GradingScale {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name      String  @db.VarChar(100)
  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bands        GradingBand[]
  examSubjects ExamSubject[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("grading_scales")
}

model GradingBand {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  gradingScaleId String @map("grading_scale_id") @db.Uuid

  minPercent Decimal  @map("min_percent") @db.Decimal(5, 2)
  maxPercent Decimal  @map("max_percent") @db.Decimal(5, 2)
  grade      String   @db.VarChar(10)
  points     Decimal? @db.Decimal(4, 2)
  remark     String?  @db.VarChar(50)

  gradingScale GradingScale @relation(fields: [gradingScaleId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, gradingScaleId, grade])
  @@unique([id, tenantId])
  @@index([tenantId, gradingScaleId])
  @@map("grading_bands")
}

// ---------------------------------------------------------------------------
// HOLIDAYS
// ---------------------------------------------------------------------------

model Holiday {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name   String   @db.VarChar(150)
  date   DateTime @db.Date
  termId String?  @map("term_id") @db.Uuid

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  term   AcademicTerm? @relation(fields: [termId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, date])
  @@unique([id, tenantId])
  @@index([tenantId, date])
  @@map("holidays")
}

// ---------------------------------------------------------------------------
// PAYROLL
// ---------------------------------------------------------------------------

enum DeductionValueType {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("deduction_value_type")
}

enum PayoutStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED

  @@map("payout_status")
}

// A reusable pay-grade (e.g. "Subject Teacher"), distinct from Role (which is
// access control). Many staff can hold the same position.
model Position {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  title        String  @db.VarChar(120)
  description  String?
  baseSalary   Decimal @map("base_salary") @db.Decimal(12, 2)
  currencyCode String  @map("currency_code") @db.Char(3)
  isActive     Boolean @default(true) @map("is_active")

  departmentId String? @map("department_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department     Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignments    StaffPositionAssignment[]
  deductionRules SalaryDeductionRule[]

  @@unique([tenantId, title])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, departmentId])
  @@map("positions")
}

// History-preserving: changing a staff member's position/salary closes the old
// row (endDate) and creates a new one. Active row = endDate null.
model StaffPositionAssignment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  userId         String   @map("user_id") @db.Uuid
  positionId     String   @map("position_id") @db.Uuid
  salaryOverride Decimal? @map("salary_override") @db.Decimal(12, 2)

  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position       @relation(fields: [positionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  payouts  SalaryPayout[]

  @@unique([id, tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, positionId])
  @@map("staff_position_assignments")
}

model SalaryDeductionRule {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name        String             @db.VarChar(120)
  valueType   DeductionValueType @map("value_type")
  value       Decimal            @db.Decimal(12, 2)
  description String?

  // Reserved for future per-position variants; null = applies to all positions.
  appliesToPositionId String? @map("applies_to_position_id") @db.Uuid

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  position     Position?                    @relation(fields: [appliesToPositionId], references: [id], onDelete: SetNull)
  applications SalaryDeductionApplication[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId, isActive])
  @@map("salary_deduction_rules")
}

model SalaryPayout {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  userId               String  @map("user_id") @db.Uuid
  positionAssignmentId String  @map("position_assignment_id") @db.Uuid
  financialPeriodId    String? @map("financial_period_id") @db.Uuid

  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date

  grossAmount     Decimal @map("gross_amount") @db.Decimal(12, 2)
  totalDeductions Decimal @default(0) @map("total_deductions") @db.Decimal(12, 2)
  netAmount       Decimal @map("net_amount") @db.Decimal(12, 2)
  currencyCode    String  @map("currency_code") @db.Char(3)

  status    PayoutStatus @default(DRAFT)
  accountId String?      @map("account_id") @db.Uuid
  payslipNo String       @map("payslip_no") @db.VarChar(50)

  approvedBy    String?   @map("approved_by") @db.Uuid
  paidAt        DateTime? @map("paid_at") @db.Timestamptz(6)
  paymentMethod String?   @map("payment_method") @db.VarChar(50)
  reference     String?   @db.VarChar(100)
  notes         String?

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant             Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  positionAssignment StaffPositionAssignment      @relation(fields: [positionAssignmentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  financialPeriod    FinancialPeriod?             @relation(fields: [financialPeriodId], references: [id], onDelete: SetNull)
  account            FinancialAccount?            @relation(fields: [accountId], references: [id], onDelete: SetNull)
  deductions         SalaryDeductionApplication[]

  @@unique([tenantId, payslipNo])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, userId])
  @@index([tenantId, periodStart])
  @@map("salary_payouts")
}

model SalaryDeductionApplication {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  payoutId String  @map("payout_id") @db.Uuid
  ruleId   String? @map("rule_id") @db.Uuid

  label            String             @db.VarChar(120)
  valueType        DeductionValueType @map("value_type")
  value            Decimal            @db.Decimal(12, 2)
  // Resolved at payout time and frozen; never re-derived from a later salary.
  calculatedAmount Decimal            @map("calculated_amount") @db.Decimal(12, 2)
  note             String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payout SalaryPayout         @relation(fields: [payoutId, tenantId], references: [id, tenantId], onDelete: Cascade)
  rule   SalaryDeductionRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@unique([id, tenantId])
  @@index([tenantId, payoutId])
  @@map("salary_deduction_applications")
}

// ---------------------------------------------------------------------------
// SIBLING / FAMILY-CONDITION DISCOUNTS
// ---------------------------------------------------------------------------

enum SiblingRelationType {
  SISTERS
  BROTHERS
  SISTERS_AND_BROTHERS

  @@map("sibling_relation_type")
}

// Unified payment-time discount sources. MANUAL covers approvals that come
// from the discounts-tab assign path (not composed by the sibling sync).
enum DiscountSourceType {
  SIBLING
  TOPPER
  FAMILY_CONDITION
  MANUAL

  @@map("discount_source_type")
}

// Manual grouping: finance links students who are siblings. Eligibility for a
// sibling discount comes from membership here, not from guardian auto-detection.
model SiblingGroup {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  name      String?             @db.VarChar(120)
  relation  SiblingRelationType
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members SiblingGroupMember[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("sibling_groups")
}

model SiblingGroupMember {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  groupId   String @map("group_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group   SiblingGroup @relation(fields: [groupId, tenantId], references: [id, tenantId], onDelete: Cascade)
  student Student      @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([groupId, studentId])
  @@unique([id, tenantId])
  @@index([tenantId, studentId])
  @@map("sibling_group_members")
}

model SiblingDiscountRule {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  name            String              @db.VarChar(120)
  relationType    SiblingRelationType @map("relation_type")
  minSiblingCount Int                 @map("min_sibling_count")
  valueType       DeductionValueType  @map("value_type")
  value           Decimal             @db.Decimal(12, 2)
  isActive        Boolean             @default(true) @map("is_active")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@map("sibling_discount_rules")
}

// Sensitive hardship path. `reason` is restricted to privileged finance roles
// and redacted everywhere else; always requires approval (never auto-applied).
model FamilyConditionDiscount {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid

  valueType DeductionValueType @map("value_type")
  value     Decimal            @db.Decimal(12, 2)
  reason    String

  status     FinancialApprovalStatus @default(PENDING)
  approvedBy String?                 @map("approved_by") @db.Uuid
  recordedBy String                  @map("recorded_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, studentId])
  @@map("family_condition_discounts")
}

// Topper-of-class rule catalog (mirrors SiblingDiscountRule). Rules are
// generic — every active rule is evaluated for every class's rank-1 student.
model TopperDiscountRule {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  name      String             @db.VarChar(120)
  valueType DeductionValueType @map("value_type")
  value     Decimal            @db.Decimal(12, 2)
  isActive  Boolean            @default(true) @map("is_active")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@map("topper_discount_rules")
}

// Payment-time source of truth for all applied discounts. Rows are created
// already-effective: by the approve-path bridge (SIBLING/MANUAL/FAMILY_CONDITION)
// or by the topper compute (TOPPER). Validity = expiresAt + appliedAmount.
// `label` is display-only; the sensitive family-condition `reason` is never
// copied here, so receipts/exports are redacted by construction.
model DiscountEligibility {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  studentId      String             @map("student_id") @db.Uuid
  sourceType     DiscountSourceType @map("source_type")
  sourceRefId    String?            @map("source_ref_id") @db.Uuid
  valueType      DeductionValueType @map("value_type")
  value          Decimal            @db.Decimal(12, 2)
  label          String             @db.VarChar(200)
  academicYearId String?            @map("academic_year_id") @db.Uuid
  expiresAt      DateTime?          @map("expires_at") @db.Timestamptz(6)
  appliedAmount  Decimal            @default(0) @map("applied_amount") @db.Decimal(12, 2)
  appliedAt      DateTime?          @map("applied_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student               @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  academicYear AcademicYear?         @relation(fields: [academicYearId, tenantId], references: [id, tenantId], onDelete: SetNull)
  applications DiscountApplication[]

  @@unique([id, tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, academicYearId])
  @@map("discount_eligibilities")
}

// One row per discount reduction consumed against a billing target inside a
// payment. A discount is applied once (tracked on the eligibility); reversing
// the paired payment does not un-apply it (price reduction, not cash).
model DiscountApplication {
  id                    String                @id @default(uuid()) @db.Uuid
  tenantId              String                @map("tenant_id") @db.Uuid
  studentId             String                @map("student_id") @db.Uuid
  studentFeeStructureId String                @map("student_fee_structure_id") @db.Uuid
  eligibilityId         String                @map("eligibility_id") @db.Uuid
  paymentId             String?               @map("payment_id") @db.Uuid
  targetKind            PaymentAllocationKind @map("target_kind")
  installmentNo         Int?                  @map("installment_no")
  amount                Decimal               @db.Decimal(12, 2)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student             Student             @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  studentFeeStructure StudentFeeStructure @relation(fields: [studentFeeStructureId, tenantId], references: [id, tenantId], onDelete: Cascade)
  eligibility         DiscountEligibility @relation(fields: [eligibilityId, tenantId], references: [id, tenantId], onDelete: Restrict)
  payment             Payment?            @relation(fields: [paymentId, tenantId], references: [id, tenantId], onDelete: SetNull)

  @@unique([id, tenantId])
  @@index([tenantId, studentFeeStructureId])
  @@index([tenantId, eligibilityId])
  @@index([tenantId, paymentId])
  @@map("discount_applications")
}

// ---------------------------------------------------------------------------
// TRANSPORT
// ---------------------------------------------------------------------------

enum BusStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE

  @@map("bus_status")
}

enum TransportShift {
  MORNING
  EVENING
  BOTH

  @@map("transport_shift")
}

enum TransportTripStatus {
  IN_PROGRESS
  COMPLETED

  @@map("transport_trip_status")
}

enum TransportTripEventType {
  STARTED
  ARRIVED_STOP

  @@map("transport_trip_event_type")
}

model Bus {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  plateNumber String @map("plate_number") @db.VarChar(30)
  model       String @db.VarChar(100)
  capacity    Int

  // Driver kept inline (single-driver-per-bus model).
  driverName             String @map("driver_name") @db.VarChar(160)
  driverPhone            String @map("driver_phone") @db.VarChar(30)
  driverLicenseNumber    String @map("driver_license_number") @db.VarChar(100)
  driverEmergencyContact String @map("driver_emergency_contact") @db.VarChar(160)

  status BusStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routes TransportRoute[]

  @@unique([tenantId, plateNumber])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@map("buses")
}

model TransportRoute {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name  String         @db.VarChar(160)
  shift TransportShift @default(BOTH)

  busId String? @map("bus_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bus         Bus?                  @relation(fields: [busId, tenantId], references: [id, tenantId], onDelete: SetNull)
  stops       RouteStop[]
  assignments TransportAssignment[]
  trips       TransportTrip[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId, shift])
  @@index([tenantId, busId])
  @@map("transport_routes")
}

model RouteStop {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  routeId  String @map("route_id") @db.Uuid
  name     String @db.VarChar(160)
  sequence Int

  // ETA as "HH:MM" local time strings; per-shift because a route may run one
  // or both directions with different traffic.
  morningEta String? @map("morning_eta") @db.VarChar(5)
  eveningEta String? @map("evening_eta") @db.VarChar(5)

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  route                TransportRoute        @relation(fields: [routeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  transportAssignments TransportAssignment[]
  transportTripEvents  TransportTripEvent[]

  @@unique([id, tenantId])
  @@unique([routeId, sequence])
  @@index([tenantId, routeId])
  @@map("route_stops")
}

model TransportAssignment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  studentId String  @map("student_id") @db.Uuid
  routeId   String  @map("route_id") @db.Uuid
  stopId    String? @map("stop_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student        @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  route   TransportRoute @relation(fields: [routeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  stop    RouteStop?     @relation(fields: [stopId, tenantId], references: [id, tenantId], onDelete: SetNull)

  @@unique([studentId, tenantId])
  @@unique([id, tenantId])
  @@index([tenantId, routeId])
  @@index([tenantId, stopId])
  @@map("transport_assignments")
}

model TransportTrip {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  routeId  String              @map("route_id") @db.Uuid
  tripDate DateTime            @map("trip_date") @db.Date
  status   TransportTripStatus @default(IN_PROGRESS)

  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  route  TransportRoute       @relation(fields: [routeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  events TransportTripEvent[]

  @@unique([id, tenantId])
  @@index([tenantId, routeId, status])
  @@index([tenantId, tripDate])
  @@map("transport_trips")
}

model TransportTripEvent {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  tripId String                 @map("trip_id") @db.Uuid
  stopId String?                @map("stop_id") @db.Uuid
  type   TransportTripEventType

  at DateTime @default(now()) @map("at") @db.Timestamptz(6)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip   TransportTrip @relation(fields: [tripId, tenantId], references: [id, tenantId], onDelete: Cascade)
  stop   RouteStop?    @relation(fields: [stopId, tenantId], references: [id, tenantId], onDelete: SetNull)

  @@unique([id, tenantId])
  @@index([tenantId, tripId])
  @@map("transport_trip_events")
}

// ---------------------------------------------------------------------------
// PLATFORM CONTROL PLANE (super-admin)
// ---------------------------------------------------------------------------
// Cross-tenant control surface. These models deliberately live OUTSIDE the
// tenantId-everywhere discipline: PlatformAdmin/PlatformPlan/PlatformAuditLog/
// PlatformAnnouncement/PlatformBackup are global rows. TenantLicense,
// PlatformInvoice, TenantModule, TenantFeatureFlag and ImpersonationSession
// keep the tenantId + composite-unique idiom for tenant-safe lookups.

enum PlatformAdminRole {
  SUPER_ADMIN
  SUPPORT

  @@map("platform_admin_role")
}

enum PlatformAdminStatus {
  ACTIVE
  SUSPENDED

  @@map("platform_admin_status")
}

enum BillingModel {
  LIFETIME
  ANNUAL

  @@map("billing_model")
}

enum LicenseStatus {
  ACTIVE
  DUE
  EXPIRED
  SUSPENDED

  @@map("license_status")
}

enum InvoiceKind {
  LICENSE
  ONBOARDING
  HOSTING
  ADJUSTMENT

  @@map("invoice_kind")
}

enum InvoiceStatus {
  PAID
  DUE
  VOID

  @@map("invoice_status")
}

enum PortalModule {
  ADMIN
  ACADEMIC
  FINANCIAL
  TEACHER
  GUARDIAN
  STUDENT
  TRANSPORT
  RECEPTION

  @@map("portal_module")
}

enum AnnouncementSeverity {
  INFO
  WARNING
  CRITICAL

  @@map("announcement_severity")
}

model PlatformAdmin {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  role   PlatformAdminRole   @default(SUPER_ADMIN)
  status PlatformAdminStatus @default(ACTIVE)

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user                     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonations           ImpersonationSession[]
  recordedExpensesInvoices PlatformInvoice[]      @relation("PlatformInvoiceRecorder")
  recordedExpenses         PlatformExpense[]      @relation("PlatformExpenseRecorder")
  recordedPayments         PlatformPayment[]      @relation("PlatformPaymentRecorder")
  backups                  PlatformBackup[]
  auditEntries             PlatformAuditLog[]     @relation("PlatformAuditActor")
  announcements            PlatformAnnouncement[] @relation("PlatformAnnouncementAuthor")

  @@index([status])
  @@map("platform_admins")
}

enum PlanTier {
  PRIMARY
  INTERMEDIATE
  ADVANCED
  CUSTOM

  @@map("plan_tier")
}

// Platform-side money enums. They are separate from the tenant finance
// enums (PaymentMethod, PaymentStatus, ExpenseStatus) because the platform
// books money in many currencies and against licenses, not against fee
// schedules.
enum PlatformExpenseCategory {
  INFRASTRUCTURE
  MARKETING
  LEGAL
  SUPPORT
  OTHER

  @@map("platform_expense_category")
}

enum PlatformPaymentMethod {
  BANK_TRANSFER
  CHEQUE
  CASH
  BANK_API

  @@map("platform_payment_method")
}

enum PlatformPaymentType {
  MANUAL_TRANSFER
  CASH_DEPOSIT
  BANK_API_PENDING

  @@map("platform_payment_type")
}

model PlatformCurrency {
  // ISO 4217 code, the primary key.
  code String @id @db.Char(3)
  name String @db.VarChar(80)

  countryCode String? @map("country_code") @db.Char(2)
  symbol      String? @db.VarChar(8)

  // Units of this currency per 1 USD. USD itself is 1.
  rateToUsd Decimal @map("rate_to_usd") @db.Decimal(18, 6)

  // Live rate sync is a per-currency switch: a rate that is synced
  // automatically may still be overridden by hand.
  autoSync     Boolean   @default(false) @map("auto_sync")
  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz(6)
  isActive     Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive])
  @@map("platform_currencies")
}

model PlatformExpense {
  id       String                  @id @default(uuid()) @db.Uuid
  title    String                  @db.VarChar(200)
  category PlatformExpenseCategory

  // NULL means the cost is allocated globally rather than to one market.
  countryCode String? @map("country_code") @db.Char(2)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("USD") @db.Char(3)

  paidAt DateTime @map("paid_at") @db.Timestamptz(6)
  notes  String?  @db.VarChar(400)

  recordedById String?  @map("recorded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  recordedBy PlatformAdmin? @relation("PlatformExpenseRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([countryCode])
  @@index([paidAt])
  @@map("platform_expenses")
}

model PlatformPayment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  licenseId String? @map("license_id") @db.Uuid

  amount   Decimal @db.Decimal(12, 2)
  currency String  @db.Char(3)

  method PlatformPaymentMethod
  type   PlatformPaymentType   @default(MANUAL_TRANSFER)

  paidAt DateTime @map("paid_at") @db.Timestamptz(6)

  // Bank reference, cheque number, or deposit slip reference.
  reference String? @db.VarChar(80)
  notes     String? @db.VarChar(400)

  recordedById String?  @map("recorded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  license    TenantLicense? @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  recordedBy PlatformAdmin? @relation("PlatformPaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([tenantId, paidAt])
  @@index([currency])
  @@map("platform_payments")
}

model PlatformPlan {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(60)
  name String @db.VarChar(160)

  billingModel BillingModel @map("billing_model")
  region       String?      @db.VarChar(40)

  // The yearly price a school pays for this tier. The console shows the
  // monthly equivalent, which is calculated from this number.
  price    Decimal @default(0) @db.Decimal(12, 2)
  currency String  @default("USD") @db.Char(3)
  isActive Boolean @default(true) @map("is_active")

  // NULL tier = a legacy row (self-onboarded schools on the LEGACY plan)
  // that predates the tier catalogue.
  tier PlanTier?

  // Audience line shown on the tier card ("Small schools / Early-stage academies").
  target String? @db.VarChar(200)

  // Portals the tier entitles a school to. Descriptive today: the tenant
  // request path does not gate on module rows yet.
  includedModules PortalModule[] @default([]) @map("included_modules")

  // Features and limits the tier grants, e.g.
  // { "whatsappAttendance": true, "maxStudents": 500, "slaHours": 8 }.
  features Json @default("{}")

  // The base term in days. A licence runs for one, two, three... of these,
  // so the shortest subscription is a year.
  durationDays Int @default(365) @map("duration_days")

  // Card order in the console.
  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  licenses TenantLicense[]

  @@index([isActive])
  @@index([tier])
  @@map("platform_plans")
}

model TenantLicense {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  planId   String @map("plan_id") @db.Uuid

  status LicenseStatus @default(ACTIVE)

  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  seats     Int?

  // The yearly amount this licence bills. It overrides the tier's price,
  // which is what a quoted tier needs: the tier says "price on request" and
  // the licence carries the agreed yearly rate.
  yearlyPrice Decimal? @map("yearly_price") @db.Decimal(12, 2)

  notes String? @db.VarChar(400)

  // Set when the license is ended early (manual termination) or by the
  // expiration sweep. A null value means the term is still running.
  terminatedAt      DateTime? @map("terminated_at") @db.Timestamptz(6)
  terminationReason String?   @map("termination_reason") @db.VarChar(40)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     PlatformPlan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices PlatformInvoice[]
  payments PlatformPayment[]

  @@unique([id, tenantId])
  @@index([tenantId, status])
  // Drives the expiration sweep: "active licenses that ended before now".
  @@index([status, expiresAt])
  @@map("tenant_licenses")
}

model PlatformInvoice {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  licenseId String? @map("license_id") @db.Uuid

  number String        @unique @db.VarChar(40)
  kind   InvoiceKind
  status InvoiceStatus @default(DUE)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("USD") @db.Char(3)

  issuedAt DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  paidAt   DateTime? @map("paid_at") @db.Timestamptz(6)

  notes String? @db.VarChar(400)

  recordedById String?  @map("recorded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  license    TenantLicense? @relation(fields: [licenseId, tenantId], references: [id, tenantId], onDelete: SetNull)
  recordedBy PlatformAdmin? @relation("PlatformInvoiceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@map("platform_invoices")
}

model TenantModule {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  module  PortalModule
  enabled Boolean      @default(true)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module])
  @@unique([id, tenantId])
  @@map("tenant_modules")
}

model TenantFeatureFlag {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  key     String  @db.VarChar(80)
  enabled Boolean @default(false)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@unique([id, tenantId])
  @@map("tenant_feature_flags")
}

model PlatformAuditLog {
  id String @id @default(uuid()) @db.Uuid

  actorId String? @map("actor_id") @db.Uuid

  action     String  @db.VarChar(80)
  entityType String? @map("entity_type") @db.VarChar(60)
  entityId   String? @map("entity_id") @db.Uuid

  tenantId String? @map("tenant_id") @db.Uuid

  oldValues Json? @map("old_values")
  newValues Json? @map("new_values")

  ipAddress String? @map("ip_address") @db.VarChar(64)
  userAgent String? @map("user_agent") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor PlatformAdmin? @relation("PlatformAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([tenantId])
  @@index([actorId])
  @@map("platform_audit_logs")
}

model PlatformAnnouncement {
  id String @id @default(uuid()) @db.Uuid

  title    String               @db.VarChar(200)
  body     String               @db.Text
  severity AnnouncementSeverity @default(INFO)

  isActive    Boolean  @default(true) @map("is_active")
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy PlatformAdmin @relation("PlatformAnnouncementAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([isActive, publishedAt])
  @@map("platform_announcements")
}

model ImpersonationSession {
  id String @id @default(uuid()) @db.Uuid

  tenantId        String @map("tenant_id") @db.Uuid
  targetUserId    String @map("target_user_id") @db.Uuid
  platformAdminId String @map("platform_admin_id") @db.Uuid

  // SHA-256 of the one-time code; the raw code is shown to the platform
  // operator exactly once and never stored.
  codeHash String @unique @map("code_hash") @db.VarChar(80)

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  redeemedAt DateTime? @map("redeemed_at") @db.Timestamptz(6)
  redeemedIp String?   @map("redeemed_ip") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([platformAdminId, createdAt])
  @@map("impersonation_sessions")
}

model PlatformBackup {
  id String @id @default(uuid()) @db.Uuid

  tenantId String? @map("tenant_id") @db.Uuid

  fileName  String @map("file_name") @db.VarChar(200)
  format    String @db.VarChar(10)
  sizeBytes BigInt @map("size_bytes")

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdBy PlatformAdmin? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("platform_backups")
}
